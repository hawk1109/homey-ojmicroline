  "flow": {
    "triggers": [
      {
        "id": "heating_started",
        "title": {
          "en": "Heating turned on",
          "nl": "Verwarming ging aan"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          }
        ]
      },
      {
        "id": "heating_stopped",
        "title": {
          "en": "Heating turned off",
          "nl": "Verwarming ging uit"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          }
        ]
      },
      {
        "id": "mode_changed",
        "title": {
          "en": "Mode changed",
          "nl": "Modus is veranderd"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode",
              "nl": "Modus"
            },
            "example": {
              "en": "Schedule",
              "nl": "Programma"
            }
          },
          {
            "name": "previous_mode",
            "type": "string",
            "title": {
              "en": "Previous mode",
              "nl": "Vorige modus"
            },
            "example": {
              "en": "Manual",
              "nl": "Handmatig"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_heating",
        "title": {
          "en": "Is !{{heating|not heating}}",
          "nl": "Verwarmt !{{wel|niet}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          }
        ]
      },
      {
        "id": "mode_is",
        "title": {
          "en": "Mode !{{is|is not}}",
          "nl": "Modus !{{is|is niet}}"
        },
        "titleFormatted": {
          "en": "Mode !{{is|is not}} [[mode]]",
          "nl": "Modus !{{is|is niet}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              {
                "id": "schedule",
                "title": {
                  "en": "Schedule",
                  "nl": "Programma"
                }
              },
              {
                "id": "comfort",
                "title": {
                  "en": "Comfort",
                  "nl": "Comfort"
                }
              },
              {
                "id": "manual",
                "title": {
                  "en": "Manual",
                  "nl": "Handmatig"
                }
              },
              {
                "id": "boost",
                "title": {
                  "en": "Boost",
                  "nl": "Boost"
                }
              },
              {
                "id": "eco",
                "title": {
                  "en": "Eco",
                  "nl": "Eco"
                }
              },
              {
                "id": "frost_protection",
                "title": {
                  "en": "Frost protection",
                  "nl": "Vorstbeveiliging"
                }
              },
              {
                "id": "vacation",
                "title": {
                  "en": "Vacation",
                  "nl": "Vakantie"
                }
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "resume_schedule",
        "title": {
          "en": "Resume schedule",
          "nl": "Programma hervatten"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          }
        ]
      },
      {
        "id": "set_comfort",
        "title": {
          "en": "Set temporary temperature",
          "nl": "Tijdelijke temperatuur instellen"
        },
        "titleFormatted": {
          "en": "Set [[temperature]] °C for [[minutes]] minutes, then resume schedule",
          "nl": "Zet [[temperature]] °C voor [[minutes]] minuten, daarna terug naar programma"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          },
          {
            "name": "temperature",
            "type": "range",
            "min": 5,
            "max": 40,
            "step": 0.5,
            "label": " °C",
            "labelDecimals": 1,
            "title": {
              "en": "Temperature",
              "nl": "Temperatuur"
            }
          },
          {
            "name": "minutes",
            "type": "number",
            "min": 15,
            "max": 1440,
            "step": 15,
            "placeholder": {
              "en": "240",
              "nl": "240"
            },
            "title": {
              "en": "Minutes",
              "nl": "Minuten"
            }
          }
        ]
      },
      {
        "id": "set_manual",
        "title": {
          "en": "Hold temperature (manual)",
          "nl": "Temperatuur vasthouden (handmatig)"
        },
        "titleFormatted": {
          "en": "Hold [[temperature]] °C until changed",
          "nl": "Houd [[temperature]] °C vast tot wijziging"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          },
          {
            "name": "temperature",
            "type": "range",
            "min": 5,
            "max": 40,
            "step": 0.5,
            "label": " °C",
            "labelDecimals": 1,
            "title": {
              "en": "Temperature",
              "nl": "Temperatuur"
            }
          }
        ]
      },
      {
        "id": "boost",
        "title": {
          "en": "Boost for 1 hour",
          "nl": "Boost gedurende 1 uur"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          }
        ]
      },
      {
        "id": "set_mode",
        "title": {
          "en": "Set mode",
          "nl": "Modus instellen"
        },
        "titleFormatted": {
          "en": "Set mode to [[mode]]",
          "nl": "Zet modus op [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=owd5"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              {
                "id": "schedule",
                "title": {
                  "en": "Schedule",
                  "nl": "Programma"
                }
              },
              {
                "id": "comfort",
                "title": {
                  "en": "Comfort",
                  "nl": "Comfort"
                }
              },
              {
                "id": "manual",
                "title": {
                  "en": "Manual",
                  "nl": "Handmatig"
                }
              },
              {
                "id": "boost",
                "title": {
                  "en": "Boost",
                  "nl": "Boost"
                }
              },
              {
                "id": "eco",
                "title": {
                  "en": "Eco",
                  "nl": "Eco"
                }
              },
              {
                "id": "frost_protection",
                "title": {
                  "en": "Frost protection",
                  "nl": "Vorstbeveiliging"
                }
              }
            ]
          }
        ]
      }
