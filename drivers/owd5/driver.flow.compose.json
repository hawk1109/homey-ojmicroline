      "title": {
        "en": "Mode changed",
        "nl": "Modus is veranderd"
      },
      "tokens": [
        {
          "name": "mode",
          "type": "string",
          "title": {
            "en": "Mode",
            "nl": "Modus"
          },
          "example": {
            "en": "Schedule",
            "nl": "Programma"
          }
        },
        {
          "name": "previous_mode",
          "type": "string",
          "title": {
            "en": "Previous mode",
            "nl": "Vorige modus"
          },
          "example": {
            "en": "Manual",
            "nl": "Handmatig"
          }
        }
      ]
    }
  ],
