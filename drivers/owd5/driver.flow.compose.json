        "nl": "Zet [[temperature]] °C voor [[minutes]] minuten, daarna terug naar programma"
      },
      "args": [
        {
          "name": "temperature",
          "type": "range",
          "min": 5,
          "max": 40,
          "step": 0.5,
          "label": " °C",
          "labelDecimals": 1,
          "title": {
            "en": "Temperature",
            "nl": "Temperatuur"
          }
        },
        {
          "name": "minutes",
          "type": "number",
          "min": 15,
          "max": 1440,
          "step": 15,
          "placeholder": {
            "en": "240",
            "nl": "240"
          },
          "title": {
            "en": "Minutes",
            "nl": "Minuten"
          }
        }
      ]
    },
    {
      "id": "set_manual",
